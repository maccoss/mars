<Project>

  <!--
    MARS targets net10.0.

    It used to build net8.0 by default with net10.0 behind an opt-in property, because
    pwiz-sharp - the ProteoWizard .NET port MARS reads vendor formats through - was itself
    net8.0, and .NET reference compatibility is forward-only: a net8.0 project cannot
    reference a net10.0 one. pwiz-sharp retargeted to net10.0 in ProteoWizard/pwiz PR #4619,
    so the constraint now points the other way and MARS has to be net10.0 to build against it
    at all.

    That raises the SDK floor: building MARS needs a .NET 10 SDK (10.0.100 or newer, which is
    what pwiz's own global.json asks for). RUNNING a release artifact needs nothing - they are
    self-contained - and a framework-dependent build rolls forward, so this is a build-machine
    requirement rather than a deployment one.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Pinned rather than 'latest' so the language version does not silently track
         whichever SDK a developer happens to have installed. C# 14 is the ceiling of the
         .NET 10 SDK, so this is the newest version CI can compile; naming it means a
         developer on a future SDK cannot use syntax that compiles locally and fails in CI.
         Raising this means raising the SDK floor in .github/workflows/dotnet.yml too. -->
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Company>University of Washington</Company>
    <Product>MARS</Product>
    <Copyright>Copyright (c) University of Washington 2026</Copyright>
    <Version>26.2.0</Version>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
