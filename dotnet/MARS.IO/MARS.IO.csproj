<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MARS.IO</RootNamespace>
    <AssemblyName>MARS.IO</AssemblyName>
    <Description>mzML passthrough reader/writer and spectral library readers for MARS.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MARS.Core\MARS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Parquet.Net" Version="5.4.0" />
    <!-- Parquet.Net -> IronCompress -> Snappier 1.2.0, which carries GHSA-pggp-6c3x-2xmx
         (high severity). Referenced directly to lift the transitive version; remove this
         once Parquet.Net ships a dependency chain that resolves 1.3.1 or later on its own.
         Snappy is the codec DIA-NN writes, so this is on the path MARS actually uses. -->
    <PackageReference Include="Snappier" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MARS.Test" />
  </ItemGroup>

</Project>
